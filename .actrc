# act configuration for repogerbil
# https://github.com/nektos/act
#
# Run the CI workflow locally:
#   make act-dry       # validate without running containers
#   make act-ci        # run the quality job end-to-end
#
# Pattern borrowed from provide-io/octowright/.actrc.

# Runner image. We use catthehacker/ubuntu:runner-24.04 (~1.4 GB) instead of
# the smaller act-24.04 (~250 MB) because runner-XX.XX puts node in /usr/bin,
# matching the GitHub-hosted runner layout. act-XX.XX installs node via nvm,
# which raw `docker exec` calls from act do not source — so JS actions like
# actions/upload-artifact@v7 and actions/setup-python@v5 fail with
# "node: not found". One-time bigger pull buys byte-for-byte parity between
# `make act-ci` and the real CI run.
#
# Only ubuntu-latest is mapped here — our workflow uses that label exclusively.
-P ubuntu-latest=catthehacker/ubuntu:runner-24.04

# Apple Silicon: force amd64 emulation so amd64 images pull and run.
--container-architecture linux/amd64

# Colima compatibility: don't bind-mount the host daemon socket path.
--container-daemon-socket -

# Avoid non-loopback bind selection issues in some local environments.
--artifact-server-addr 127.0.0.1
--cache-server-addr 127.0.0.1
--no-cache-server

# Pull images if needed (first run; cached thereafter).
--pull

# Default workflow.
--workflows .github/workflows/ci.yml
